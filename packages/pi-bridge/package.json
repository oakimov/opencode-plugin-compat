{
  "name": "@opencode-compat/pi-bridge",
  "version": "0.2.3",
  "description": "Dynamically run unmodified OpenCode aisdk-type plugins as providers on pi or oh-my-pi (omp)",
  "type": "module",
  "license": "MPL-2.0",
  "author": "oakimov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakimov/opencode-plugin-compat.git",
    "directory": "packages/pi-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "omp": {
    "extensions": [
      "./dist/extension-omp.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extension-pi.js"
    ]
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "prepack": "bunx tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@oh-my-pi/pi-ai": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.12",
    "typescript": "^5.8.3"
  },
  "bugs": {
    "url": "https://github.com/oakimov/opencode-plugin-compat/issues"
  },
  "homepage": "https://github.com/oakimov/opencode-plugin-compat/tree/main/packages/pi-bridge#readme",
  "keywords": [
    "opencode",
    "ocp",
    "oh-my-pi",
    "omp",
    "pi",
    "ai-sdk",
    "provider"
  ],
  "engines": {
    "bun": ">=1.2.0"
  }
}
